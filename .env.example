APP_NAME="Smart Inventory Vision"
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=CHANGE_THIS_TO_RANDOM_64_CHAR_HEX
API_KEY=CHANGE_THIS_TO_RANDOM_32_CHAR_HEX

CAMERA_0_URL=0
CAMERA_0_NAME="Main Entrance Camera"
CAMERA_0_ZONE="Zone A"
# CAMERA_1_URL=rtsp://admin:password@192.168.1.101:554/stream
# CAMERA_1_NAME="Zone B Camera"
# CAMERA_1_ZONE="Zone B"
CAMERA_PROCESSING_FPS=2.0
CAMERA_DISPLAY_FPS=25.0

CLAUDE_API_KEY=
CLAUDE_VISION_ENABLED=true
CLAUDE_ANALYSIS_INTERVAL=10
CLAUDE_MODEL=claude-sonnet-4-20250514
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.45

DATABASE_URL=sqlite+aiosqlite:///./data/siv.db
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=30

STOCK_LOW_THRESHOLD=0.50
STOCK_CRITICAL_THRESHOLD=0.25
STOCK_EMPTY_THRESHOLD=0.10
AUTO_PO_APPROVAL_LIMIT=5000

LINE_NOTIFY_TOKEN=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

GOSOFT_ERP_URL=
GOSOFT_ERP_API_KEY=
SAP_B1_SERVICE_URL=
SAP_B1_USERNAME=
SAP_B1_PASSWORD=
WEBHOOK_URL=

VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
